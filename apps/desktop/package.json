{
  "name": "blackrain-desktop",
  "private": true,
  "version": "0.7.68",
  "description": "Open-source Electron Codex client for Windows",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/goodbyeri-studio/blackrain-desktop.git",
    "directory": "apps/desktop"
  },
  "bugs": {
    "url": "https://github.com/goodbyeri-studio/blackrain-desktop/issues"
  },
  "homepage": "https://github.com/goodbyeri-studio/blackrain-desktop",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "sync:material-icons": "node scripts/sync-material-icons.mjs",
    "postinstall": "npm run sync:material-icons",
    "predev": "npm run sync:material-icons",
    "dev": "vite",
    "prebuild": "npm run sync:material-icons",
    "build": "tsc && vite build",
    "electron:start": "electron-forge start",
    "preelectron:package": "npm run electron:runtime:verify && npm run electron:node-runtime:verify && npm run electron:browser-client:verify",
    "electron:package": "electron-forge package",
    "electron:make": "electron-forge make && npm run electron:package:audit -- --require-msix",
    "electron:make:release": "node scripts/verify-release-signing.mjs && npm run electron:runtime:verify && npm run electron:node-runtime:verify && npm run electron:browser-client:verify && electron-forge make && npm run electron:package:audit -- --require-msix",
    "electron:package:audit": "node scripts/audit-electron-package.mjs",
    "electron:browser-client:verify": "node scripts/verify-browser-client.mjs",
    "electron:browser-runtime-seam:probe": "node scripts/probe-browser-runtime-seam.mjs",
    "electron:browser-runtime-seam:gate": "node scripts/probe-browser-runtime-seam.mjs --gate",
    "electron:runtime:check-lock": "node scripts/verify-codex-runtime.mjs --lock-only",
    "electron:runtime:vendor": "pwsh -NoProfile -File ../../scripts/vendor-electron-codex-runtime.ps1",
    "electron:runtime:verify": "node scripts/verify-codex-runtime.mjs",
    "electron:node-runtime:check-lock": "node scripts/verify-node-runtime.mjs --lock-only",
    "electron:node-runtime:vendor": "pwsh -NoProfile -File ../../scripts/vendor-electron-node-runtime.ps1",
    "electron:node-runtime:verify": "node scripts/verify-node-runtime.mjs",
    "electron:app-server:probe": "node scripts/probe-bundled-app-server.mjs",
    "electron:install-runtime": "node node_modules/electron/install.js",
    "preelectron:smoke": "npm run electron:package",
    "electron:smoke": "node scripts/electron-smoke.mjs",
    "preelectron:e2e": "npm run electron:package && npm run electron:install-runtime",
    "electron:e2e": "node scripts/electron-e2e-supervisor.mjs",
    "electron:native-input:probe": "node scripts/electron-native-input-probe.mjs",
    "electron:typecheck": "tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:ds": "eslint . --ext .ts,.tsx",
    "check:host-boundary": "node scripts/check-host-boundary.mjs",
    "codemod:modal-shell": "node scripts/codemods/modal-shell-codemod.mjs",
    "codemod:panel-shell": "node scripts/codemods/panel-shell-codemod.mjs",
    "codemod:toast-shell": "node scripts/codemods/toast-shell-codemod.mjs",
    "codemod:ds:dry": "npm run codemod:modal-shell -- --dry-run && npm run codemod:panel-shell -- --dry-run && npm run codemod:toast-shell -- --dry-run",
    "codemod:ds": "npm run codemod:modal-shell && npm run codemod:panel-shell && npm run codemod:toast-shell",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run electron:typecheck",
    "preview": "vite preview"
  },
  "dependencies": {
    "@pierre/diffs": "^1.0.6",
    "@sentry/react": "^10.36.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-virtual": "^3.13.18",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.562.0",
    "node-pty": "1.1.0",
    "prismjs": "^1.30.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.1",
    "@electron-forge/maker-msix": "7.11.1",
    "@electron-forge/plugin-fuses": "7.11.1",
    "@electron-forge/plugin-vite": "7.11.1",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.10.1",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "42.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^27.0.1",
    "playwright-core": "1.62.0",
    "typescript": "5.9.3",
    "vite": "8.1.3",
    "vscode-material-icons": "^0.1.1",
    "vitest": "3.2.4"
  }
}
