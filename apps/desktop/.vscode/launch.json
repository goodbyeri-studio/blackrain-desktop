{
  "version": "0.2.0",
  "configurations": [
    {
      // 调试 Electron main 进程（app-server stdio transport、Browser backend、
      // IPC 校验等）。走 Forge 自带的 vscode 包装脚本，等价于 electron:start。
      "name": "Electron Main",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/@electron-forge/cli/script/vscode.sh",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/@electron-forge/cli/script/vscode.cmd"
      },
      "console": "integratedTerminal",
      "outputCapture": "std",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // 调试 Vitest 单个测试文件：先在编辑器打开目标测试，再启动此配置。
      "name": "Vitest: 当前文件",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
