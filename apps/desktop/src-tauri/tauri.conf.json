{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlackRain",
  "version": "0.7.68",
  "identifier": "cc.goodbyeri.blackrain",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "BlackRain",
        "width": 1200,
        "height": 700,
        "minWidth": 360,
        "minHeight": 600,
        "dragDropEnabled": true,
        "decorations": true,
        "shadow": true,
        "titleBarStyle": "Visible",
        "hiddenTitle": false,
        "transparent": false,
        "visible": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../../../gateway/gateway.py": "gateway/gateway.py",
      "resources/office-cli": "office-cli",
      "../../../plugins/office-cli": "plugins/office-cli",
      "../../../workbenches/office-agent": "workbenches/office-agent"
    },
    "iOS": {
      "frameworks": [
        "libz.tbd",
        "libiconv.tbd"
      ]
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0QTgzQUU0QTc2MEVBNDMKUldSRDZtQ241RHFvOURJbm1KeC81aEZaOXlhZHlHd2NEZVpPVWs5NjdjOFNhUFEyZGJpTkV0S2YK",
      "endpoints": [
        "https://github.com/goodbyeri-studio/blackrain-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
