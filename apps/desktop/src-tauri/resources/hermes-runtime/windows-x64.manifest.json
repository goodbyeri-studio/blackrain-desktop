{
  "schemaVersion": 1,
  "platform": "windows-x64",
  "python": {
    "version": "3.12.8",
    "source": "uv-managed-python",
    "requiresPython": ">=3.11,<3.14"
  },
  "hermes": {
    "repository": "https://github.com/NousResearch/hermes-agent.git",
    "tag": "v2026.7.7.2",
    "commit": "9de9c25f620ff7f1ce0fd5457d596052d5159596",
    "version": "0.18.2",
    "license": "MIT",
    "licenseSha256": "821556e6336796450ab852d375117b48a4887e71d255794fd6318d99982a5ab6",
    "pyprojectSha256": "7f0180b23c28ea3f7a32e037bcfb1d986fa1925d0a9331112bdce82ef1bfbf45",
    "uvLockSha256": "92d8153c76379a4d427eaf37cd77cedef9dc093c6c44c1386abd4546578f709a"
  },
  "install": {
    "mode": "uv-sync-frozen-no-dev-no-editable",
    "extras": [
      "mcp"
    ],
    "additionalPackages": [
      "aiohttp==3.14.1"
    ],
    "reason": "Hermes API server imports aiohttp without a dedicated extra; WORK plugin activation requires the locked mcp extra. BlackRain still excludes the full messaging extra."
  },
  "requiredDistributions": {
    "aiohttp": "3.14.1",
    "mcp": "1.26.0",
    "starlette": "1.0.1"
  },
  "excludedExtras": [
    "messaging",
    "edge-tts",
    "honcho",
    "hindsight",
    "voice",
    "all"
  ],
  "forbiddenDistributions": [
    "python-telegram-bot",
    "discord.py",
    "slack-bolt",
    "slack-sdk",
    "edge-tts",
    "honcho-ai",
    "hindsight-client",
    "supermemory",
    "mem0ai",
    "uvloop"
  ],
  "entrypoints": {
    "hermes": "venv/Scripts/hermes.exe",
    "python": "venv/Scripts/python.exe",
    "gatewayArgs": ["gateway"]
  }
}
