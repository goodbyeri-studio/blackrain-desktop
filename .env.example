# 2049-app 本地开发环境变量模板
#
# 用法：复制本文件为 .env，填入你自己的 key。.env 已被 gitignore，绝不提交。
#   cp .env.example .env  &&  编辑 .env 填入真实值
#
# ⚠️ 密钥只放本地 .env 或本地环境变量，永不写进任何会提交的文件、也不在聊天/IM 里明文发送。

# ── 模型 Provider 密钥（按需填，用哪个填哪个）──
# DeepSeek：https://platform.deepseek.com/  控制台获取
DEEPSEEK_API_KEY=

# 其余国产 provider（接入时再启用，base_url 见 docs/05-模型路由.md）
# GLM_API_KEY=
# QWEN_API_KEY=
# MOONSHOT_API_KEY=
